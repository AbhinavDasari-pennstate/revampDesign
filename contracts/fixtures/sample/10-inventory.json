          "level": 1,
          "order": 0,
          "text": "About Us"
        },
        {
          "block_id": "p02-b002",
          "kind": "paragraph",
          "level": null,
          "order": 1,
          "text": "Maple Grove High School opened in 1962 and moved to its current building on Orchard Road in 1998. Students choose from 14 Advanced Placement courses, a career and technical program, and more than 30 clubs and teams."
        },
        {
          "block_id": "p02-b003",
          "kind": "paragraph",
          "level": null,
          "order": 2,
          "text": "Principal: Dana Whitfield"
        },
        {
          "block_id": "p02-b004",
          "kind": "legal",
          "level": null,
          "order": 3,
          "text": "Maple Grove Local School District does not discriminate on the basis of race, color, national origin, sex, disability or age in its programs and activities."
        },
