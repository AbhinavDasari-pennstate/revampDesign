{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "start-request.v1",
  "title": "Body of POST /api/jobs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invite_code",
    "url",
    "owner_name",
    "consent"
  ],
  "properties": {
    "invite_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S+$"
    },
    "url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://\\S+$"
    },
    "owner_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "consent": {
      "const": true
    }
  }
}
