---
import Blocks from './Blocks.astro';

interface Image { id: string; src: string; alt: string; width: number | null; height: number | null }
interface Props {
  id: string;
  headline: string;
  subhead?: string | null;
  pattern?: string | null;
  blocks?: { id: string; kind: string; text: string }[];
  images?: Image[];
}
const { id, headline, subhead = null, pattern = null, blocks = [], images = [] } = Astro.props;
---
<section id={id} data-intent="hero" data-pattern={pattern} class="bg-accent text-on-accent">
  <div class="wrap reveal flex flex-wrap items-center justify-between gap-8 py-20">
    <div class="max-w-[60ch]">
      <h1 class="font-display font-bold" style="font-size: var(--t-3)">{headline}</h1>
      {subhead && <p class="mt-4" style="font-size: var(--t-1)">{subhead}</p>}
      <Blocks blocks={blocks} />
    </div>
    {images.map((img) => (
      <img data-src={img.id} src={img.src} alt={img.alt} width={img.width} height={img.height} />
    ))}
  </div>
</section>
